{
  "manifest_version": 3,
  "name": "UnSponsored",
  "version": "1.7.1",
  "description": "Hide sponsored content on Google, mobile.de, Ecosia, and other supported sites.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.google.co.uk/*",
    "https://www.google.de/*",
    "https://www.mobile.de/*",
    "https://suchen.mobile.de/*",
    "https://home.mobile.de/*",
    "https://www.ecosia.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.google.de/*",
        "https://www.mobile.de/*",
        "https://suchen.mobile.de/*",
        "https://home.mobile.de/*",
        "https://www.ecosia.org/*"
      ],
      "js": ["UnSponsored.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "unsponsored@kreusel.dev",
      "strict_min_version": "115.0"
    }
  }
}
